{
  "name": "slidev-theme-touying",
  "version": "0.1.10",
  "type": "module",
  "description": "Touying Slidev presets including the white Apple-inspired NEW theme",
  "keywords": [
    "slidev-theme",
    "slidev",
    "touying",
    "new",
    "dewdrop",
    "university",
    "simple",
    "simple-serif",
    "sydney"
  ],
  "author": {
    "name": "_Kerman",
    "email": "kermanx@qq.com",
    "url": "https://github.com/kermanx"
  },
  "homepage": "https://github.com/jessecu2024/slidev-theme-touying#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/jessecu2024/slidev-theme-touying.git"
  },
  "license": "MIT",
  "engines": {
    "slidev": ">=0.52.0"
  },
  "scripts": {
    "dev": "slidev",
    "build": "slidev build ./entry.md",
    "build:new": "slidev build ./examples/new.md --out ../dist/new",
    "build:dewdrop": "slidev build ./examples/dewdrop.md --out ../dist/dewdrop",
    "build:university": "slidev build ./examples/university.md --out ../dist/university",
    "build:simple": "slidev build ./examples/simple.md --out ../dist/simple",
    "build:simple-serif": "slidev build ./examples/simple-serif.md --out ../dist/simple-serif",
    "build:sydney": "slidev build ./examples/sydney.md --out ../dist/sydney",
    "build:sydney:gallery": "slidev build ./examples/sydney/gallery.md --out ../../dist/sydney-gallery",
    "build:sydney:interview": "slidev build ./examples/sydney/interview.md --out ../../dist/sydney-interview",
    "build:sydney:consulting": "slidev build ./examples/sydney/consulting.md --out ../../dist/sydney-consulting",
    "build:sydney:academic": "slidev build ./examples/sydney/academic.md --out ../../dist/sydney-academic",
    "build:sydney:tech": "slidev build ./examples/sydney/tech.md --out ../../dist/sydney-tech",
    "dev:entry": "slidev ./entry.md",
    "dev:new": "slidev ./examples/new.md",
    "dev:dewdrop": "slidev ./examples/dewdrop.md",
    "dev:university": "slidev ./examples/university.md",
    "dev:simple": "slidev ./examples/simple.md",
    "dev:simple-serif": "slidev ./examples/simple-serif.md",
    "dev:sydney": "slidev ./examples/sydney.md",
    "dev:sydney:gallery": "slidev ./examples/sydney/gallery.md",
    "dev:sydney:interview": "slidev ./examples/sydney/interview.md",
    "dev:sydney:consulting": "slidev ./examples/sydney/consulting.md",
    "dev:sydney:academic": "slidev ./examples/sydney/academic.md",
    "dev:sydney:tech": "slidev ./examples/sydney/tech.md"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "aspectRatio": "16/9",
      "fonts": {
        "serif": "Libertinus Serif, Linux Libertine, Noto Serif SC, Source Han Serif SC, Noto Serif CJK SC, Georgia, serif",
        "sans": "Fira Sans",
        "mono": "Fira Code",
        "weights": "400,600",
        "local": "Libertinus Serif, Linux Libertine, Source Han Serif SC, Noto Serif CJK SC, Georgia, serif"
      }
    }
  },
  "files": [
    "composables",
    "components",
    "docs",
    "examples",
    "layouts",
    "setup",
    "styles",
    "themes",
    "package.json",
    "README.md",
    "LICENSE",
    "slides.md",
    "uno.config.ts",
    "global-top.vue"
  ],
  "devDependencies": {
    "@slidev/cli": "^52.14.1",
    "@slidev/types": "^52.14.1",
    "@types/node": "^25.5.0",
    "playwright-chromium": "^1.62.1"
  },
  "dependencies": {
    "@antfu/utils": "^9.3.0",
    "@fontsource/libertinus-serif": "^5.2.1",
    "@vueuse/core": "^14.2.1"
  }
}
