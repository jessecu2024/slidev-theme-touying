{
  "name": "slidev-theme-touying",
  "version": "0.1.10",
  "type": "module",
  "description": "Four original Apple-inspired Slidev presentation systems built on Touying",
  "keywords": [
    "slidev-theme",
    "slidev",
    "touying",
    "harbour",
    "sandstone",
    "studio",
    "sydney"
  ],
  "author": {
    "name": "_Kerman",
    "email": "kermanx@qq.com",
    "url": "https://github.com/kermanx"
  },
  "homepage": "https://github.com/jessecu2024/slidev-theme-touying#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/jessecu2024/slidev-theme-touying.git"
  },
  "license": "MIT",
  "engines": {
    "slidev": ">=0.52.0"
  },
  "scripts": {
    "dev": "slidev",
    "build": "slidev build ./entry.md",
    "build:harbour": "slidev build ./examples/harbour.md --out ../dist/harbour",
    "build:sandstone": "slidev build ./examples/sandstone.md --out ../dist/sandstone",
    "build:studio": "slidev build ./examples/studio.md --out ../dist/studio",
    "build:sydney": "slidev build ./examples/sydney.md --out ../dist/sydney",
    "build:sydney:gallery": "slidev build ./examples/sydney/gallery.md --out ../../dist/sydney-gallery",
    "build:sydney:interview": "slidev build ./examples/sydney/interview.md --out ../../dist/sydney-interview",
    "build:sydney:consulting": "slidev build ./examples/sydney/consulting.md --out ../../dist/sydney-consulting",
    "build:sydney:academic": "slidev build ./examples/sydney/academic.md --out ../../dist/sydney-academic",
    "build:sydney:tech": "slidev build ./examples/sydney/tech.md --out ../../dist/sydney-tech",
    "dev:entry": "slidev ./entry.md",
    "dev:harbour": "slidev ./examples/harbour.md",
    "dev:sandstone": "slidev ./examples/sandstone.md",
    "dev:studio": "slidev ./examples/studio.md",
    "dev:sydney": "slidev ./examples/sydney.md",
    "dev:sydney:gallery": "slidev ./examples/sydney/gallery.md",
    "dev:sydney:interview": "slidev ./examples/sydney/interview.md",
    "dev:sydney:consulting": "slidev ./examples/sydney/consulting.md",
    "dev:sydney:academic": "slidev ./examples/sydney/academic.md",
    "dev:sydney:tech": "slidev ./examples/sydney/tech.md"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "aspectRatio": "16/9",
      "fonts": {
        "serif": "Georgia, serif",
        "sans": "Inter, Helvetica Neue, Arial, sans-serif",
        "mono": "SFMono-Regular, SF Mono, Menlo, Consolas, monospace",
        "weights": "400,500,600,700"
      }
    }
  },
  "files": [
    "composables",
    "components",
    "docs",
    "examples",
    "layouts",
    "setup",
    "styles",
    "themes",
    "package.json",
    "README.md",
    "LICENSE",
    "slides.md",
    "uno.config.ts",
    "global-top.vue"
  ],
  "devDependencies": {
    "@slidev/cli": "^52.14.1",
    "@slidev/types": "^52.14.1",
    "@types/node": "^25.5.0",
    "playwright-chromium": "^1.62.1"
  },
  "dependencies": {
    "@antfu/utils": "^9.3.0",
    "@vueuse/core": "^14.2.1"
  }
}
